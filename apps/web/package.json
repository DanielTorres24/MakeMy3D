{
  "name": "@makemy3d/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/server.mjs",
    "build": "next build",
    "start": "node ../../scripts/server.mjs --production",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/data.ts seed",
    "reset": "tsx scripts/data.ts reset",
    "catalog:seed": "tsx scripts/data.ts catalog"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
