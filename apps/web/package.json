    "seed": "tsx scripts/data.ts seed",
    "reset": "tsx scripts/data.ts reset"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "vitest": "5.0.5",
    "tsx": "^4.20.6"
  }
