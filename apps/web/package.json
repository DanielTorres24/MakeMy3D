{
  "name": "@makemy3d/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/server.mjs",
    "build": "next build",
    "start": "node ../../scripts/server.mjs --production",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
