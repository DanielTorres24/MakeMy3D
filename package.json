{
  "name": "makemy3d",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @makemy3d/web",
    "build": "npm run build --workspace @makemy3d/web",
    "start": "npm run start --workspace @makemy3d/web",
    "lint": "npm run lint --workspace @makemy3d/web",
    "typecheck": "npm run typecheck --workspace @makemy3d/web",
    "test": "npm run test --workspace @makemy3d/web",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed": "npm run seed --workspace @makemy3d/web",
    "reset": "npm run reset --workspace @makemy3d/web",
    "catalog:seed": "npm run catalog:seed --workspace @makemy3d/web"
  }
